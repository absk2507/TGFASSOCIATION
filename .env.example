# =================================================================
# TGF ASSOCIATION Environment Variables Example
# =================================================================

# Server & Runtime
NODE_ENV=production
PORT=10000

# Database Configuration (MySQL connection string)
# Example: mysql://user:password@host:port/database_name
# Render provides external MySQL / you can use Aiven, PlanetScale, TiDB, Railway, AWS RDS, etc.
DATABASE_URL=mysql://root:password@localhost:3306/tgf_db

# Authentication & Session Security
# Provide a secure random string for JWT session signing in production
JWT_SECRET=your_production_jwt_secret_key_change_in_production
OWNER_OPEN_ID=

# OAuth & Frontend Integration (Optional / as needed)
OAUTH_SERVER_URL=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=

# Built-in Storage Proxy (Optional)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Google Maps / Frontend API Proxy (Optional)
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

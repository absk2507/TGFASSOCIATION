<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <radialGradient id="vBg" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#4e3579"/>
      <stop offset="60%" stop-color="#281a42"/>
      <stop offset="100%" stop-color="#140c24"/>
    </radialGradient>
    <linearGradient id="vGold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffe18f"/>
      <stop offset="50%" stop-color="#d4a34b"/>
      <stop offset="100%" stop-color="#885b1a"/>
    </linearGradient>
  </defs>
  <rect width="600" height="600" fill="url(#vBg)"/>
  <circle cx="300" cy="280" r="180" fill="#7552aa" opacity="0.3"/>
  <g transform="translate(300, 320)">
    <!-- Mukut -->
    <path d="M-35 -140 L0 -230 L35 -140 L20 -115 L-20 -115 Z" fill="url(#vGold)"/>
    <circle cx="0" cy="-238" r="8" fill="#ffe18f"/>
    <!-- Face -->
    <path d="M-50 -100 C-85 -105 -110 -55 -80 -10 C-60 15 -45 5 -40 -20" fill="#9d74d8"/>
    <path d="M50 -100 C85 -105 110 -55 80 -10 C60 15 45 5 40 -20" fill="#9d74d8"/>
    <path d="M-40 -95 C-50 -35 -35 20 -10 55 C0 68 15 68 20 55 C25 40 10 30 5 10 C0 -10 15 -30 20 -60 C20 -95 0 -110 -40 -95 Z" fill="#b993f0"/>
    <line x1="0" y1="-95" x2="0" y2="-60" stroke="#ffd875" stroke-width="5" stroke-linecap="round"/>
    <!-- Robe -->
    <path d="M-110 160 C-95 65 -50 40 0 40 C50 40 95 65 110 160 Z" fill="#583b8b"/>
    <path d="M-70 70 Q0 130 70 70" fill="none" stroke="url(#vGold)" stroke-width="8"/>
  </g>
  <text x="300" y="550" font-family="'Fraunces', Georgia, serif" font-size="22" font-weight="bold" fill="#ffe18f" text-anchor="middle" letter-spacing="2">2025 • VIOLET IDOL</text>
</svg>